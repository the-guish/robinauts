#
# The template demo/config.py fills in for demo/start.sh, writing
# demo/.state/robinauts.toml. The @-marked names below are the only things it
# replaces, and the base_url one is a whole line: it goes altogether for a kind
# that has no endpoint to write. The file it writes is not committed
# (demo/.gitignore) and is read back before it is kept. Nothing above this line
# may spell one of those names, since a name left unreplaced anywhere is how
# config.py knows the template and it have drifted apart.
#
# The **model half alone**. The demo runs the local development mode, which may
# be given a configuration file and reads only its model tables; a file holding
# any sign-in table -- public_url, session_hours, providers, allow, admin -- is
# a start-up refusal there (docs/specs/sign-in.md). So there is none here, and
# there is no key here either: a provider names the environment variable its
# key is read from, and nothing else (docs/specs/agents.md).

[model_providers.@PROVIDER_ID@]
kind = "@PROVIDER_KIND@"
api_key_env = "@KEY_VARIABLE@"
@BASE_URL@

# Three models through the one provider, so that the model picker has
# something to switch to. Which three depends on the provider's kind, and
# demo/start.sh chooses them: through OpenRouter, Claude, GPT and Gemini, since
# OpenRouter serves every vendor's models behind the one Messages API; through
# Anthropic itself, three Claude models, and through OpenAI itself, three GPT
# models, since that is all each serves. Each id names its default model,
# whichever key reaches it, so that a conversation on one another key does
# not offer is refused as not offered rather than answered by another. A model
# an operator chose instead keeps the default's id, which then no longer names
# it (demo/README.md, "What you can change"). A title is what the picker shows,
# and is the vendor's name for a model an operator chose.
[models.@MODEL_ID@]
provider = "@PROVIDER_ID@"
name = "@MODEL_NAME@"
title = "@MODEL_TITLE@"

[models.@MODEL_2_ID@]
provider = "@PROVIDER_ID@"
name = "@MODEL_2_NAME@"
title = "@MODEL_2_TITLE@"

[models.@MODEL_3_ID@]
provider = "@PROVIDER_ID@"
name = "@MODEL_3_NAME@"
title = "@MODEL_3_TITLE@"

# Two agents, one per engine, both on the first model by default: the agent
# picker shows the swap the project exists to prove (docs/specs/agents.md). An
# agent is chosen when a conversation is started and stays with it, so seeing
# both means starting a chat with each. The model does not stay: it is the
# agent's default until the user picks another, on the empty chat or at any
# point during a conversation, and either engine runs any of the three.
[agents.assistant-langgraph]
title = "Assistant (LangGraph)"
model = "@MODEL_ID@"
engine = "langchain"
system_prompt = "You are the Robinauts demo assistant. Answer briefly, and play fair."
@TOOLS@

[agents.assistant-pydantic-ai]
title = "Assistant (Pydantic AI)"
model = "@MODEL_ID@"
engine = "pydantic-ai"
system_prompt = "You are the Robinauts demo assistant. Answer briefly, and play fair."
@TOOLS@

# Tools. GitHub's server is on when demo/start.sh found a GitHub token, and its
# table and each agent's `tools = ["github"]` line are then written in place of
# the @-marked lines; with no token both lines go, and the agents have no tools.
# The token itself is never in this file: the platform reads it from the
# variable `secret_env` names, which demo/start.sh sets on the server's
# invocation alone (demo/README.md, "Tools").
#
# Microsoft Learn's public server needs no credential: take the `#` off its
# table, and add "learn" to an agent's `tools` (or add the line), and that
# agent searches Microsoft's documentation when a question calls for it -- the
# demo then reaches learn.microsoft.com from this machine, and the chat shows
# each call behind a toggle above the answer.
@GITHUB_SERVER@
#
# [tool_servers.learn]
# url = "https://learn.microsoft.com/api/mcp"
# auth = "none"
#
# Composio's hosted MCP servers take the key in a header of their own, not in
# `Authorization`, so their table says which: `auth = "header"` and
# `header = "x-api-key"`. The key is your Composio project's API key, read from
# the variable `secret_env` names; export it in the shell that runs
# demo/start.sh. Unlike GitHub's token, start.sh does not take it out of its
# environment, so the tools it runs see it too. SERVER_ID is the MCP server's id in Composio, and `user_id` is the
# Composio user whose connected accounts the tools act through. One deployment
# is one identity to a tool server, so that user is yours, the operator's, for
# every person who chats -- not the person in the chat. The URL ends in `/mcp`,
# Composio's streamable HTTP endpoint, which the bare server URL redirects to.
#
# [tool_servers.composio]
# url = "https://backend.composio.dev/v3/mcp/SERVER_ID/mcp?user_id=USER_ID"
# auth = "header"
# header = "x-api-key"
# secret_env = "COMPOSIO_API_KEY"
