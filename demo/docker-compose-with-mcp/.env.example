# Copy to .env beside it, fill in, then: chmod 600 .env
# start.sh reads it only when no one else can read it. git ignores .env.

# Required: the models, through OpenRouter (https://openrouter.ai/keys).
OPENROUTER_API_KEY=

# Optional: web search, through Brave (https://brave.com/search/api/).
BRAVE_API_KEY=

# Optional: Composio's apps, such as Google Maps (https://composio.dev).
COMPOSIO_API_KEY=
