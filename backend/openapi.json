                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            },
            "description": "A refusal"
          }
        },
        "summary": "List Apps"
      }
    },
    "/robinauts/api/apps/{server}/tools/{tool}": {
      "post": {
        "operationId": "call_app_tool_robinauts_api_apps__server__tools__tool__post",
        "parameters": [
          {
            "in": "path",
            "name": "server",
            "required": true,
            "schema": {
              "title": "Server",
              "type": "string"
            }
          },
          {
            "in": "path",
            "name": "tool",
            "required": true,
            "schema": {
              "title": "Tool",
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/AppToolCallRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AppToolCallResponse"
                }
              }
            },
            "description": "Successful Response"
          },
          "default": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            },
            "description": "A refusal"
          }
        },
        "summary": "Call App Tool"
      }
    },
    "/robinauts/api/changes": {
      "get": {
        "description": "The user's change version: at once without ``after``, else once it differs from\n``after`` or ``timeout`` seconds have passed. It signals and carries nothing else.",
        "operationId": "changes_robinauts_api_changes_get",
        "parameters": [
          {
            "in": "query",
            "name": "after",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "minimum": 0,
                  "type": "integer"
                },
                {
                  "type": "null"
                }
              ],
              "title": "After"
            }
          },
          {
            "in": "query",
            "name": "timeout",
            "required": false,
            "schema": {
              "default": 25.0,
              "maximum": 30.0,
              "minimum": 0,
              "title": "Timeout",
              "type": "number"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ChangesResponse"
                }
              }
            },
            "description": "Successful Response"
          },
          "default": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            },
            "description": "A refusal"
          }
        },
        "summary": "Changes"
      }
    },
