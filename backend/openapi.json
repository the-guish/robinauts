  "paths": {
    "/robinauts/api/agents": {
      "get": {
        "operationId": "list_agents_robinauts_api_agents_get",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AgentListResponse"
                }
              }
            },
            "description": "Successful Response"
          },
          "default": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            },
            "description": "A refusal"
          }
        },
        "summary": "List Agents"
      }
    },
    "/robinauts/api/apps": {
      "get": {
        "operationId": "list_apps_robinauts_api_apps_get",
        "parameters": [
          {
            "in": "query",
            "name": "agent",
            "required": true,
            "schema": {
              "title": "Agent",
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
