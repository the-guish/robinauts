# The wheel, and what `uv build` writes into it. backend/hatch_build.py stages
# the three licence files beside pyproject.toml while a wheel is being built
# and removes them afterwards; these lines are what keeps a build that failed
# part way from leaving a copy of one in a commit.
backend/dist/
backend/LICENSE
backend/NOTICE
backend/THIRD_PARTY_LICENSES.txt
# Generated from backend/openapi.json by `npm run generate`, on every check.
frontend/src/api/schema.d.ts

# Scratch space: review findings and other working files.
tmp/
