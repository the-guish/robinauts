#
# The same rules as frontend/.npmrc (docs/contributing/js-dependencies.md).
#
# Install scripts never run: a package that needs one is a reason to pick another.
ignore-scripts=true
# Exact versions in package.json; an update is a deliberate diff.
save-exact=true
