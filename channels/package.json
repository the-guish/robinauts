{
  "name": "robinauts-channels",
  "version": "0.1.0",
  "private": true,
  "description": "Bridges from chat platforms (Telegram, Slack) to a Robinauts deployment, on CopilotKit's Channels SDK.",
  "license": "Apache-2.0",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "start": "node src/main.ts",
    "test": "node --test \"test/**/*.test.ts\"",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write .",
    "check": "prettier --check . && tsc --noEmit && npm test"
  },
  "dependencies": {
    "@copilotkit/channels-core": "0.11.0",
    "@copilotkit/channels-slack": "0.11.0",
    "@copilotkit/channels-telegram": "0.11.0"
  },
  "devDependencies": {
    "@types/node": "24.13.4",
    "prettier": "3.9.9",
    "typescript": "5.9.3"
  }
}
