#
# The bridge's configuration. Copy to .env, which is never committed, and fill it in.

# --- the deployment -------------------------------------------------------------------------

# Its base URL, as the container sees it. host.docker.internal is the laptop, on Docker Desktop.
ROBINAUTS_API_URL=http://host.docker.internal:8000
# The same secret the backend is started with, in the variable of the same name: at least 32
# characters, such as the output of `openssl rand -hex 32`.
ROBINAUTS_CHANNELS_SECRET=
# The agent the platforms talk to: an id of the deployment's configuration. The demo's are
# assistant-langgraph and assistant-pydantic-ai.
ROBINAUTS_AGENT_ID=assistant-langgraph
# Optional: a model of the deployment's. Unset, the agent's default.
ROBINAUTS_MODEL_ID=

# --- Telegram -------------------------------------------------------------------------------

# From @BotFather. Unset, there is no Telegram.
TELEGRAM_BOT_TOKEN=
# Who may use the bot: Telegram user ids or usernames, comma-separated, or * for everyone.
# Required with a token: anyone can find a bot. Somebody left out is told their id.
TELEGRAM_ALLOWED_USERS=

# --- Slack (Socket Mode) --------------------------------------------------------------------

# The bot token (xoxb-…) and the app-level token (xapp-…, with connections:write). Both unset,
# there is no Slack.
SLACK_BOT_TOKEN=
SLACK_APP_TOKEN=
# Optional: Slack member ids, comma-separated. Unset, the whole workspace.
SLACK_ALLOWED_USERS=

# --- the bridge ------------------------------------------------------------------------------

# Show "using <tool>…" while the agent calls a tool. On unless false.
CHANNELS_SHOW_TOOL_STATUS=true
