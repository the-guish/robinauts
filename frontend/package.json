{
  "name": "robinauts-frontend",
  "private": true,
  "version": "0.0.0",
  "description": "The Robinauts web UI; built into the robinauts wheel",
  "license": "Apache-2.0",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "generate": "openapi-typescript ../backend/openapi.json -o src/api/schema.d.ts",
    "dev": "npm run generate && vite",
    "build": "npm run generate && tsc -b && vite build",
    "typecheck": "npm run generate && tsc -b",
    "lint": "npm run generate && eslint .",
    "test": "npm run generate && vitest",
    "format": "prettier --write .",
    "check-format": "prettier --check ."
  },
  "dependencies": {
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@testing-library/dom": "10.4.2",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@types/node": "24.19.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "eslint": "10.13.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "globals": "17.13.0",
    "jsdom": "30.1.3",
    "openapi-typescript": "7.13.0",
    "prettier": "3.9.10",
    "rollup-plugin-license": "3.7.1",
    "typescript": "5.9.3",
    "typescript-eslint": "8.72.0",
    "vite": "8.3.5",
    "vitest": "5.0.5"
  },
  "overrides": {
    "minimatch": "11.0.1",
    "source-map-js": "1.2.2"
  }
}
