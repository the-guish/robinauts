{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noUncheckedIndexedAccess": true,
    "isolatedModules": true,
    "verbatimModuleSyntax": true,
    "resolveJsonModule": true,
    "allowJs": true,
    "checkJs": true,
    "noEmit": true,
    "skipLibCheck": true,
    "types": ["node"],
    "tsBuildInfoFile": "node_modules/.tmp/tools.tsbuildinfo"
  },
  "include": [
    "scripts",
    "vite.config.ts",
    "src/test/seam-rule.test.ts",
    "src/test/licence-gate.test.ts",
    "src/test/build-rules.test.ts"
  ]
}
