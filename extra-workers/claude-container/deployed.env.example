# A deployment. Copy to /etc/robinauts/claude-container.env, owned by root, mode 0600, and
# fill in the two values. The operator makes both; Robinauts makes neither (CREDENTIALS.md).

# The worker's secret: a long random string, the same the server reads from the variable its
# [workers.claude-container] table names (docs/deployment.md, section 6).
ROBINAUTS_WORKER_SECRET=

# The Claude Platform API key, created in the Claude Console (platform.claude.com) by the
# operator. The variable's NAME is whatever the model provider's `api_key_env` says in
# robinauts.toml; ANTHROPIC_API_KEY is the usual one.
ANTHROPIC_API_KEY=

# Nothing else goes here. In particular no CLAUDE_CODE_OAUTH_TOKEN: a personal subscription
# token may not serve a deployment, and the worker refuses to start with one.

# Optional knobs, with their defaults (README.md, "Configuration"):
# ROBINAUTS_CLAUDE_PERMISSION_MODE=dontAsk
# ROBINAUTS_CLAUDE_ALLOWED_TOOLS=Read,Edit,Write,Glob,Grep,Bash,WebFetch,WebSearch
# ROBINAUTS_CLAUDE_MAX_TURNS=
# ROBINAUTS_CLAUDE_MAX_BUDGET_USD=
